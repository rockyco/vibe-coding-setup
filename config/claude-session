#!/bin/bash
# claude-session: Manage persistent Claude Code tmux sessions
#
# Usage:
#   claude-session [name]        - Attach to session (creates if needed)
#   claude-session -l            - List sessions
#   claude-session -k [name]     - Kill session
#   claude-session -n name       - Create new session (don't attach)
#   claude-session -r [name]     - Recreate session (kill + create fresh)
#   claude-session -w name [base] - Create worktree session
#   claude-session -W            - List worktree sessions
#   claude-session -f name       - Finish worktree (kill session + remove worktree)
#   claude-session -m name       - Merge worktree branch to main + finish

set -e

SESSION_PREFIX="claude"
DEFAULT_SESSION="${SESSION_PREFIX}-main"
WORKTREE_PREFIX="${SESSION_PREFIX}-wt"
STATE_DIR="$HOME/.local/state/claude-vibe"
PORTS_DIR="$STATE_DIR/ports"
DEFAULT_PORT_START=8100
DEFAULT_PORT_END=8199

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Help
# ---------------------------------------------------------------------------

show_help() {
    cat << 'EOF'
claude-session - Persistent Claude Code tmux sessions

Usage:
  claude-session              Attach to default session
  claude-session <name>       Attach to named session
  claude-session -l           List all claude sessions
  claude-session -k [name]    Kill session (default if no name)
  claude-session -n <name>    Create new session without attaching
  claude-session -r [name]    Recreate session (kill + create fresh)
  claude-session -w <name> [base]  Create worktree session
  claude-session -W           List all worktree sessions with status
  claude-session -f <name>    Finish worktree (kill session + remove worktree)
  claude-session -m <name>    Merge worktree branch to main + finish
  claude-session -h           Show this help

Examples:
  claude-session              Attach to claude-main
  claude-session project      Attach to claude-project
  claude-session -n experiment Create claude-experiment in background
  claude-session -r           Reset default session with 6 panes
  claude-session -w fix-auth  Create worktree + session for fix-auth
  claude-session -W           Show worktree session status table
  claude-session -f fix-auth  Cleanup fix-auth worktree + session
  claude-session -m fix-auth  Merge fix-auth to main and cleanup
EOF
}

# ---------------------------------------------------------------------------
# State management
# ---------------------------------------------------------------------------

ensure_state_dir() {
    mkdir -p "$STATE_DIR" "$PORTS_DIR"
}

# Write a flat JSON-ish state file (one key=value per line, no jq needed)
write_state() {
    local session_name="$1"
    local worktree_path="$2"
    local branch="$3"
    local project_root="$4"
    local port="$5"
    local state_file="$STATE_DIR/${session_name}.state"

    cat > "$state_file" << EOF
session=$session_name
worktree=$worktree_path
branch=$branch
project=$project_root
port=$port
created=$(date +%s)
EOF
}

read_state_field() {
    local session_name="$1"
    local field="$2"
    local state_file="$STATE_DIR/${session_name}.state"
    if [[ -f "$state_file" ]]; then
        grep "^${field}=" "$state_file" 2>/dev/null | cut -d= -f2-
    fi
}

remove_state() {
    local session_name="$1"
    rm -f "$STATE_DIR/${session_name}.state"
}

# ---------------------------------------------------------------------------
# Port allocation (file-lock based)
# ---------------------------------------------------------------------------

allocate_port() {
    local session_name="$1"
    local port_start="$DEFAULT_PORT_START"
    local port_end="$DEFAULT_PORT_END"

    # Load project config overrides if available
    if [[ -n "${VIBE_PORT_RANGE_START:-}" ]]; then
        port_start="$VIBE_PORT_RANGE_START"
    fi
    if [[ -n "${VIBE_PORT_RANGE_END:-}" ]]; then
        port_end="$VIBE_PORT_RANGE_END"
    fi

    ensure_state_dir

    # Reclaim stale port locks first
    for port_file in "$PORTS_DIR"/*; do
        [[ -f "$port_file" ]] || continue
        local owner
        owner=$(cat "$port_file" 2>/dev/null)
        if [[ -n "$owner" ]] && ! tmux has-session -t "$owner" 2>/dev/null; then
            rm -f "$port_file"
        fi
    done

    # Find first free port in range
    for ((port = port_start; port <= port_end; port++)); do
        local port_file="$PORTS_DIR/$port"
        if [[ ! -f "$port_file" ]]; then
            echo "$session_name" > "$port_file"
            echo "$port"
            return 0
        fi
    done

    echo -e "${RED}Error: No free ports in range $port_start-$port_end${NC}" >&2
    return 1
}

release_port() {
    local session_name="$1"
    for port_file in "$PORTS_DIR"/*; do
        [[ -f "$port_file" ]] || continue
        local owner
        owner=$(cat "$port_file" 2>/dev/null)
        if [[ "$owner" == "$session_name" ]]; then
            rm -f "$port_file"
            return 0
        fi
    done
}

# ---------------------------------------------------------------------------
# Project detection and config
# ---------------------------------------------------------------------------

detect_project_root() {
    local dir="${1:-$(pwd)}"
    while [[ "$dir" != "/" ]]; do
        if [[ -d "$dir/.git" ]] || [[ -f "$dir/.git" ]]; then
            echo "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}

load_project_config() {
    local project_root="$1"
    local config_file="$project_root/.claude-vibe/config"
    if [[ -f "$config_file" ]]; then
        # shellcheck disable=SC1090
        source "$config_file"
    fi
}

run_project_hook() {
    local project_root="$1"
    local hook_name="$2"
    local worktree_path="$3"
    local hook_file="$project_root/.claude-vibe/$hook_name"
    if [[ -x "$hook_file" ]]; then
        echo -e "${BLUE}Running $hook_name hook...${NC}"
        (cd "$worktree_path" && "$hook_file")
    fi
}

# ---------------------------------------------------------------------------
# Session listing
# ---------------------------------------------------------------------------

list_sessions() {
    echo "Claude Code sessions:"
    tmux list-sessions 2>/dev/null | grep "^${SESSION_PREFIX}" || echo "  (none)"
}

# ---------------------------------------------------------------------------
# Session creation (parameterized working directory)
# ---------------------------------------------------------------------------

create_session_in_dir() {
    local name="$1"
    local work_dir="$2"
    local attach="$3"
    local worktree_env="${4:-}"  # optional: CLAUDE_VIBE_WORKTREE value

    if tmux has-session -t "$name" 2>/dev/null; then
        echo "Session '$name' already exists"
        if [[ "$attach" == "yes" ]]; then
            tmux attach -t "$name"
        fi
        return
    fi

    echo "Creating session: $name (dir: $work_dir)"

    # Create session with 6 panes in 3x2 grid layout
    # Layout:
    #   +-------+-------+-------+
    #   |   1   |   2   |   3   |  (Claude in pane 1)
    #   +-------+-------+-------+
    #   |   4   |   5   |   6   |
    #   +-------+-------+-------+

    local env_args=()
    if [[ -n "$worktree_env" ]]; then
        env_args=(-e "CLAUDE_VIBE_WORKTREE=$worktree_env")
    fi

    # Create session with large size to allow 6 panes
    tmux new-session -d -s "$name" -n "main" -x 200 -y 50 -c "$work_dir" "${env_args[@]}"

    # Set environment on the session so new panes inherit it
    if [[ -n "$worktree_env" ]]; then
        tmux set-environment -t "$name" CLAUDE_VIBE_WORKTREE "$worktree_env"
    fi

    # Split into top and bottom rows
    tmux split-window -t "$name:main" -v -c "$work_dir"

    # Split top row into 3 columns (pane 1 is top)
    tmux select-pane -t "$name:main.1"
    tmux split-window -t "$name:main" -h -c "$work_dir"
    tmux split-window -t "$name:main" -h -c "$work_dir"

    # Split bottom row into 3 columns (pane 4 is bottom after top splits)
    tmux select-pane -t "$name:main.4"
    tmux split-window -t "$name:main" -h -c "$work_dir"
    tmux split-window -t "$name:main" -h -c "$work_dir"

    # Balance the layout
    tmux select-layout -t "$name:main" tiled

    # Start Claude Code in first pane (top-left)
    tmux send-keys -t "$name:main.1" 'claude' Enter

    # Select first pane
    tmux select-pane -t "$name:main.1"

    echo "Session '$name' created with 6 panes (3x2 grid)"

    if [[ "$attach" == "yes" ]]; then
        tmux attach -t "$name"
    fi
}

# Backward-compatible wrapper: creates session in $HOME
create_session() {
    local name="$1"
    local attach="$2"
    create_session_in_dir "$name" "$HOME" "$attach"
}

# ---------------------------------------------------------------------------
# Worktree session lifecycle
# ---------------------------------------------------------------------------

create_worktree_session() {
    local wt_name="$1"
    local base_branch="${2:-}"
    local session_name="${WORKTREE_PREFIX}-${wt_name}"

    # Must be inside a git repo
    local project_root
    project_root=$(detect_project_root) || {
        echo -e "${RED}Error: Not inside a git repository${NC}" >&2
        exit 1
    }

    local repo_name
    repo_name=$(basename "$project_root")
    local worktree_path
    worktree_path="$(dirname "$project_root")/${repo_name}-wt-${wt_name}"
    local branch_name="wt/${wt_name}"

    # Check if worktree already exists
    if [[ -d "$worktree_path" ]]; then
        echo -e "${YELLOW}Worktree already exists at $worktree_path${NC}"
        if tmux has-session -t "$session_name" 2>/dev/null; then
            echo "Attaching to existing session..."
            tmux attach -t "$session_name"
            return
        fi
        echo "Recreating session for existing worktree..."
    else
        # Load project config (may set VIBE_PORT_RANGE_*, VIBE_BRANCH_PATTERN, etc.)
        load_project_config "$project_root"

        # Apply branch naming pattern if configured
        if [[ -n "${VIBE_BRANCH_PATTERN:-}" ]]; then
            branch_name="${VIBE_BRANCH_PATTERN/\%s/$wt_name}"
        fi

        echo -e "${BLUE}Creating worktree: $worktree_path (branch: $branch_name)${NC}"

        # Create git worktree
        if [[ -n "$base_branch" ]]; then
            git -C "$project_root" worktree add -b "$branch_name" "$worktree_path" "$base_branch"
        else
            git -C "$project_root" worktree add -b "$branch_name" "$worktree_path"
        fi

        echo -e "${GREEN}Worktree created${NC}"

        # Run setup hook if present
        run_project_hook "$project_root" "setup" "$worktree_path"

        # Handle symlinks from .claude-vibe/config VIBE_SYMLINKS
        if [[ -n "${VIBE_SYMLINKS:-}" ]]; then
            for item in $VIBE_SYMLINKS; do
                local src="$project_root/$item"
                local dst="$worktree_path/$item"
                if [[ -e "$src" ]] && [[ ! -e "$dst" ]]; then
                    ln -s "$src" "$dst"
                    echo "  Symlinked: $item"
                fi
            done
        fi
    fi

    ensure_state_dir

    # Allocate port
    local port
    port=$(allocate_port "$session_name") || exit 1

    # Save state
    write_state "$session_name" "$worktree_path" "$branch_name" "$project_root" "$port"

    # Create tmux session in the worktree directory
    create_session_in_dir "$session_name" "$worktree_path" "no" "$worktree_path"

    echo ""
    echo -e "${GREEN}Worktree session ready:${NC}"
    echo "  Session:  $session_name"
    echo "  Branch:   $branch_name"
    echo "  Path:     $worktree_path"
    echo "  Port:     $port"
    echo ""
    echo "Attach with: tmux attach -t $session_name"
    echo "Or press 'M for the session monitor"

    # Attach
    tmux attach -t "$session_name"
}

list_worktree_sessions() {
    ensure_state_dir

    echo ""
    printf "%-24s %-10s %-20s %6s  %s\n" "SESSION" "STATUS" "BRANCH" "FILES" "PATH"
    printf "%-24s %-10s %-20s %6s  %s\n" "-------" "------" "------" "-----" "----"

    local found=0
    for state_file in "$STATE_DIR"/${WORKTREE_PREFIX}-*.state; do
        [[ -f "$state_file" ]] || continue
        found=1

        local session branch worktree port
        session=$(grep "^session=" "$state_file" | cut -d= -f2-)
        branch=$(grep "^branch=" "$state_file" | cut -d= -f2-)
        worktree=$(grep "^worktree=" "$state_file" | cut -d= -f2-)
        port=$(grep "^port=" "$state_file" | cut -d= -f2-)

        # Check tmux session status
        local status
        if tmux has-session -t "$session" 2>/dev/null; then
            status="${GREEN}running${NC}"
        else
            status="${YELLOW}stopped${NC}"
        fi

        # Count changed files (if worktree exists)
        local file_count="-"
        if [[ -d "$worktree" ]]; then
            file_count=$(git -C "$worktree" diff --name-only HEAD 2>/dev/null | wc -l)
            local staged
            staged=$(git -C "$worktree" diff --cached --name-only 2>/dev/null | wc -l)
            file_count=$((file_count + staged))
        fi

        printf "%-24s %-10b %-20s %6s  %s\n" \
            "$session" "$status" "$branch" "$file_count" "$worktree"
    done

    if [[ "$found" -eq 0 ]]; then
        echo "  (no worktree sessions)"
    fi
    echo ""
}

finish_worktree_session() {
    local wt_name="$1"
    local session_name="${WORKTREE_PREFIX}-${wt_name}"

    local worktree
    worktree=$(read_state_field "$session_name" "worktree")
    local project
    project=$(read_state_field "$session_name" "project")

    if [[ -z "$worktree" ]]; then
        echo -e "${RED}Error: No state found for worktree session '$session_name'${NC}" >&2
        exit 1
    fi

    # Run teardown hook before cleanup
    if [[ -n "$project" ]]; then
        run_project_hook "$project" "teardown" "$worktree"
    fi

    # Kill tmux session if running
    if tmux has-session -t "$session_name" 2>/dev/null; then
        tmux kill-session -t "$session_name"
        echo -e "${GREEN}Killed session: $session_name${NC}"
    fi

    # Release port
    release_port "$session_name"

    # Remove worktree (preserves the branch)
    if [[ -d "$worktree" ]]; then
        # Check for uncommitted changes
        if [[ -n "$(git -C "$worktree" status --porcelain 2>/dev/null)" ]]; then
            echo -e "${YELLOW}Warning: Uncommitted changes in $worktree${NC}"
            read -p "Remove anyway? [y/N] " -n 1 -r
            echo ""
            if [[ ! $REPLY =~ ^[Yy]$ ]]; then
                echo "Aborted. Session killed but worktree preserved."
                remove_state "$session_name"
                return
            fi
        fi

        git -C "$(git -C "$worktree" rev-parse --git-common-dir 2>/dev/null || echo "$worktree")" \
            worktree remove --force "$worktree" 2>/dev/null || {
            # Fallback: if git worktree remove fails, remove manually
            rm -rf "$worktree"
            echo -e "${YELLOW}Removed worktree directory manually${NC}"
        }
        echo -e "${GREEN}Removed worktree: $worktree${NC}"
    fi

    # Clean up state
    remove_state "$session_name"
    echo -e "${GREEN}Finished worktree: $wt_name${NC}"
}

merge_worktree_session() {
    local wt_name="$1"
    local session_name="${WORKTREE_PREFIX}-${wt_name}"

    local worktree branch project
    worktree=$(read_state_field "$session_name" "worktree")
    branch=$(read_state_field "$session_name" "branch")
    project=$(read_state_field "$session_name" "project")

    if [[ -z "$worktree" ]] || [[ -z "$project" ]]; then
        echo -e "${RED}Error: No state found for worktree session '$session_name'${NC}" >&2
        exit 1
    fi

    # Check for uncommitted changes
    if [[ -n "$(git -C "$worktree" status --porcelain 2>/dev/null)" ]]; then
        echo -e "${RED}Error: Uncommitted changes in worktree. Commit or stash first.${NC}" >&2
        exit 1
    fi

    # Get the default branch
    local main_branch
    main_branch=$(git -C "$project" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    if [[ -z "$main_branch" ]]; then
        main_branch="main"
    fi

    echo -e "${BLUE}Merging $branch into $main_branch...${NC}"

    # Switch to main in the project root and merge
    git -C "$project" checkout "$main_branch"
    git -C "$project" merge "$branch"

    echo -e "${GREEN}Merged successfully${NC}"

    # Ask about cleanup
    read -p "Finish worktree and delete branch? [Y/n] " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]?$ ]]; then
        finish_worktree_session "$wt_name"
        git -C "$project" branch -d "$branch" 2>/dev/null && \
            echo -e "${GREEN}Deleted branch: $branch${NC}" || \
            echo -e "${YELLOW}Branch $branch not deleted (may have additional commits)${NC}"
    fi
}

# Helper: finish current worktree (called from tmux keybinding)
finish_current_worktree() {
    local wt_env="${CLAUDE_VIBE_WORKTREE:-}"
    if [[ -z "$wt_env" ]]; then
        echo "Not in a worktree session"
        return 1
    fi
    # Extract name from session: claude-wt-NAME -> NAME
    local current_session
    current_session=$(tmux display-message -p '#S')
    local wt_name="${current_session#${WORKTREE_PREFIX}-}"
    finish_worktree_session "$wt_name"
}

# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

kill_session() {
    local name="$1"

    # If it's a worktree session, also release port and clean state
    if [[ "$name" == ${WORKTREE_PREFIX}-* ]]; then
        release_port "$name"
        remove_state "$name"
    fi

    if tmux has-session -t "$name" 2>/dev/null; then
        tmux kill-session -t "$name"
        echo "Killed session: $name"
    else
        echo "Session '$name' not found"
    fi
}

attach_session() {
    local name="$1"

    if tmux has-session -t "$name" 2>/dev/null; then
        tmux attach -t "$name"
    else
        create_session "$name" "yes"
    fi
}

# ---------------------------------------------------------------------------
# Parse arguments
# ---------------------------------------------------------------------------

case "${1:-}" in
    -h|--help)
        show_help
        ;;
    -l|--list)
        list_sessions
        ;;
    -k|--kill)
        name="${2:-$DEFAULT_SESSION}"
        [[ "$name" != ${SESSION_PREFIX}-* ]] && name="${SESSION_PREFIX}-${name}"
        kill_session "$name"
        ;;
    -n|--new)
        if [[ -z "${2:-}" ]]; then
            echo "Error: -n requires a session name"
            exit 1
        fi
        name="${SESSION_PREFIX}-${2}"
        create_session "$name" "no"
        ;;
    -r|--recreate)
        name="${2:-$DEFAULT_SESSION}"
        [[ "$name" != ${SESSION_PREFIX}-* ]] && name="${SESSION_PREFIX}-${name}"
        kill_session "$name" 2>/dev/null || true
        create_session "$name" "yes"
        ;;
    -w|--worktree)
        if [[ -z "${2:-}" ]]; then
            echo "Error: -w requires a worktree name"
            exit 1
        fi
        create_worktree_session "$2" "${3:-}"
        ;;
    -W|--worktree-list)
        list_worktree_sessions
        ;;
    -f|--finish)
        if [[ -z "${2:-}" ]]; then
            echo "Error: -f requires a worktree name"
            exit 1
        fi
        finish_worktree_session "$2"
        ;;
    -m|--merge)
        if [[ -z "${2:-}" ]]; then
            echo "Error: -m requires a worktree name"
            exit 1
        fi
        merge_worktree_session "$2"
        ;;
    --finish-current)
        finish_current_worktree
        ;;
    "")
        attach_session "$DEFAULT_SESSION"
        ;;
    -*)
        echo "Unknown option: $1"
        show_help
        exit 1
        ;;
    *)
        name="${SESSION_PREFIX}-${1}"
        attach_session "$name"
        ;;
esac
